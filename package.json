{
  "name": "lyra-sync-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:desktop:preview": "pnpm --filter desktop dev:preview",
    "dev:desktop:prod": "pnpm --filter desktop dev:prod",
    "dev:pair-a": "LYRA_VARIANT=development LYRA_ALLOW_MULTI=1 LYRA_INSTANCE=a LYRA_PORT=53317 pnpm --filter desktop dev",
    "dev:pair-b": "LYRA_VARIANT=development LYRA_ALLOW_MULTI=1 LYRA_INSTANCE=b LYRA_PORT=53319 pnpm --filter desktop dev",
    "build:daemon": "pnpm --filter @lyra-sync-app/daemon build",
    "check": "biome check --write .",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@lyra-sync-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@lyra-sync-app/config": "workspace:*",
    "@types/node": "^22.13.14",
    "tsx": "^4.22.5",
    "turbo": "^2.10.2",
    "typescript": "^6",
    "vercel": "^54.18.6"
  },
  "packageManager": "pnpm@10.33.2"
}
