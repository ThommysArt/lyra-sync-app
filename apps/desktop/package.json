{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "LYRA_VARIANT=development tsx scripts/dev.ts",
    "dev:preview": "LYRA_VARIANT=preview tsx scripts/dev.ts",
    "dev:prod": "LYRA_VARIANT=production tsx scripts/dev.ts",
    "build": "tsx scripts/build-electron.ts",
    "build:electron": "tsx scripts/build-electron.ts",
    "check-types": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "pack:dev": "LYRA_VARIANT=development electron-builder --dir",
    "pack:preview": "LYRA_VARIANT=preview electron-builder --dir",
    "pack:prod": "LYRA_VARIANT=production electron-builder --dir",
    "dist": "electron-builder",
    "dist:dev": "LYRA_VARIANT=development electron-builder",
    "dist:preview": "LYRA_VARIANT=preview electron-builder",
    "dist:prod": "LYRA_VARIANT=production electron-builder"
  },
  "dependencies": {
    "@lyra-sync-app/daemon": "workspace:*",
    "@lyra-sync-app/discovery": "workspace:*",
    "@lyra-sync-app/protocol": "workspace:*",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@lyra-sync-app/config": "workspace:*",
    "@types/node": "^22.13.14",
    "electron": "^33.0.0",
    "tsx": "^4.22.5",
    "typescript": "^6",
    "vite": "^8.1.3"
  },
  "build": {
    "appId": "app.lyra.desktop",
    "productName": "Lyra",
    "artifactName": "Lyra-${version}-${variant}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist-electron/**/*", "resources/**/*", "package.json"],
    "extraResources": [{ "from": "../web/dist", "to": "web-dist", "filter": ["**/*"] }],
    "linux": { "target": ["AppImage", "dir"], "category": "Network", "icon": "resources/icon.png" },
    "mac": { "target": ["dmg", "dir"], "category": "public.app-category.utilities" },
    "win": { "target": ["nsis", "dir"] }
  }
}
